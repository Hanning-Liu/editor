# Build context: repository root. Build uses the same verified portable runtime.
# ModelScope requires a root Dockerfile; staging will copy this recipe there.
FROM oven/bun:1.4.4-alpine AS build
WORKDIR /app
RUN apk add --no-cache 'nodejs>=24.22.1-r0'
COPY . .
RUN bun install --frozen-lockfile
ENV PASCAL_PORTABLE_BUILD=1
RUN ./node_modules/.bin/turbo run build --filter=editor
RUN cd packages/cli && bun run build && bun run stage-runtime

FROM node:22.23.4-alpine AS tailnet
RUN mkdir /tailscale && wget -q https://pkgs.tailscale.com/stable/tailscale_1.104.5_amd64.tgz -O /tmp/tailscale.tgz \
    && echo '720cbbccbfc03d8b55df72afc19e5a72e31b0f65934700aa6fa38074d4ad7bf7  /tmp/tailscale.tgz' | sha256sum -c - \
    && tar -xzf /tmp/tailscale.tgz -C /tailscale --strip-components=1

FROM node:22.23.4-alpine
WORKDIR /app
ENV NODE_ENV=production HOSTNAME=0.0.0.0 PORT=7860 PASCAL_DATA_DIR=/mnt/workspace/pascal
COPY --from=build /app/packages/cli/build/runtime ./
COPY --from=tailnet /tailscale/tailscale /tailscale/tailscaled /usr/local/bin/
COPY deploy/cloud/gateway.py deploy/cloud/runtime.mjs ./deploy/cloud/
# ModelScope's persistent workspace is mounted at runtime; root owns the mount.
# The small entrypoint creates a private directory and then drops privileges.
COPY deploy/cloud/modelscope-entrypoint.sh /usr/local/bin/pascal-entrypoint
RUN chmod 755 /usr/local/bin/pascal-entrypoint && apk add --no-cache su-exec python3
EXPOSE 7860
ENTRYPOINT ["/usr/local/bin/pascal-entrypoint"]
